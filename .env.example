# Required: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma separated, first model that exists for your key is used
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
# Protects POST /api/refresh and GET /api/admin/{chats|gaps|leads}. Use a long random string.
ADMIN_TOKEN=
# Optional voice agent (see docs/VOICE.md). /api/vapi/tool stays off until VAPI_TOOL_SECRET is set.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_TOOL_SECRET=
# Optional: cap for all visitors together per 10 minutes (protects the free Gemini quota)
GLOBAL_RATE_LIMIT_REQUESTS=200
